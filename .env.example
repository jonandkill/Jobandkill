# Exact endpoint shown after applying for the official data.go.kr API.
# Keep placeholders in the URL; Job&Kill replaces them at sync time.
JOBNKILL_ALIO_API_URL_TEMPLATE=https://apis.data.go.kr/...?...&serviceKey={service_key}&pageNo={page}&numOfRows={page_size}&type=json
JOBNKILL_ALIO_SERVICE_KEY=

JOBNKILL_DB_PATH=data/jobandkill.db
JOBNKILL_DOCUMENT_DIR=data/documents
JOBNKILL_HOST=127.0.0.1
JOBNKILL_PORT=8787
JOBNKILL_PAGE_SIZE=100
JOBNKILL_MAX_PAGES=10
