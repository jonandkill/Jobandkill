# Exact endpoint shown after applying for the official data.go.kr API.
# Keep placeholders in the URL; Job&Kill replaces them at sync time.
JOBNKILL_ALIO_API_URL_TEMPLATE=https://apis.data.go.kr/...?...&serviceKey={service_key}&pageNo={page}&numOfRows={page_size}&type=json
JOBNKILL_ALIO_SERVICE_KEY=

# Production uses PostgreSQL. Never commit a real URL or password.
# Example shape: postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full
JOBNKILL_DATABASE_URL=
JOBNKILL_DB_PATH=data/jobandkill.db
JOBNKILL_STORAGE_BACKEND=local
JOBNKILL_DOCUMENT_DIR=data/documents
JOBNKILL_S3_BUCKET=
JOBNKILL_S3_PREFIX=documents
JOBNKILL_S3_REGION=ap-northeast-2
JOBNKILL_S3_ENDPOINT_URL=
JOBNKILL_S3_ENCRYPTION=AES256
JOBNKILL_S3_KMS_KEY_ID=

JOBNKILL_ENV=development
JOBNKILL_PUBLIC_URL=http://127.0.0.1:8787
JOBNKILL_AUTH_RATE_SECRET=
JOBNKILL_TRUSTED_PROXY_CIDRS=
# Development + loopback only. Returns a test link instead of sending mail.
JOBNKILL_AUTH_DEV_SHOW_LINK=0
JOBNKILL_SMTP_HOST=
JOBNKILL_SMTP_PORT=587
JOBNKILL_SMTP_SECURITY=starttls
JOBNKILL_SMTP_USERNAME=
JOBNKILL_SMTP_PASSWORD=
JOBNKILL_SMTP_FROM=

JOBNKILL_HOST=127.0.0.1
JOBNKILL_PORT=8787
JOBNKILL_PAGE_SIZE=100
JOBNKILL_MAX_PAGES=10
JOBNKILL_DOCUMENT_RECHECK_DAYS=7
