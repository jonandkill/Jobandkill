# Exact endpoint shown after applying for the official data.go.kr API.
# Keep placeholders in the URL; Job&Kill replaces them at sync time.
JOBNKILL_ALIO_API_URL_TEMPLATE=https://apis.data.go.kr/...?...&serviceKey={service_key}&pageNo={page}&numOfRows={page_size}&type=json
JOBNKILL_ALIO_SERVICE_KEY=

# Production uses PostgreSQL. Never commit a real URL or password.
# Example shape: postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full
# Render services set one role-specific URL; run_with_database_role.sh exposes
# only that URL to the process. Administrator init uses DATABASE_ROLE=admin and
# a one-time JOBNKILL_DATABASE_URL instead.
JOBNKILL_DATABASE_ROLE=
JOBNKILL_WEB_DATABASE_URL=
JOBNKILL_COLLECTOR_DATABASE_URL=
JOBNKILL_CLEANUP_DATABASE_URL=
JOBNKILL_DATABASE_URL=
# Production runtime services must use 0. Run schema changes only through the
# explicit administrator init procedure described in docs/operations.md.
JOBNKILL_AUTO_MIGRATE=1
JOBNKILL_DB_PATH=data/jobandkill.db
JOBNKILL_STORAGE_BACKEND=local
JOBNKILL_DOCUMENT_DIR=data/documents
JOBNKILL_S3_BUCKET=
JOBNKILL_S3_PREFIX=documents
JOBNKILL_S3_REGION=ap-northeast-2
JOBNKILL_S3_ENDPOINT_URL=
JOBNKILL_S3_ENCRYPTION=AES256
JOBNKILL_S3_KMS_KEY_ID=

JOBNKILL_ENV=development
JOBNKILL_PUBLIC_URL=http://127.0.0.1:8787
JOBNKILL_AUTH_RATE_SECRET=
JOBNKILL_TRUSTED_PROXY_CIDRS=
# Development + loopback only. Returns a test link instead of sending mail.
JOBNKILL_AUTH_DEV_SHOW_LINK=0
# Select smtp (default) or resend. Resend requires a verified sender address.
JOBNKILL_MAIL_TRANSPORT=smtp
JOBNKILL_SMTP_HOST=
JOBNKILL_SMTP_PORT=587
JOBNKILL_SMTP_SECURITY=starttls
JOBNKILL_SMTP_USERNAME=
JOBNKILL_SMTP_PASSWORD=
JOBNKILL_SMTP_FROM=
JOBNKILL_RESEND_API_KEY=
JOBNKILL_RESEND_FROM=
# Required in production. Publish the real Korean notices before enabling login.
JOBNKILL_PRIVACY_POLICY_URL=
JOBNKILL_PRIVACY_POLICY_VERSION=
JOBNKILL_PRIVACY_POLICY_SHA256=
# Set to 1 when personal data is processed outside Korea (the Singapore Blueprint does this).
JOBNKILL_OVERSEAS_TRANSFER_REQUIRED=0
JOBNKILL_OVERSEAS_TRANSFER_POLICY_URL=
JOBNKILL_OVERSEAS_TRANSFER_VERSION=
JOBNKILL_OVERSEAS_TRANSFER_SHA256=
# Required in production: positive integer number of days to retain inactive drafts.
JOBNKILL_DRAFT_RETENTION_DAYS=

JOBNKILL_HOST=127.0.0.1
JOBNKILL_PORT=8787
JOBNKILL_PAGE_SIZE=100
JOBNKILL_MAX_PAGES=10
JOBNKILL_DOCUMENT_RECHECK_DAYS=7
